  node_4 [label="Node 4\nNBA: 2, TS: 3\nProgress: TRA\nMax Time: 173\nBatch: 0\nRobots: [1,0,1,0]", fillcolor="#FFFFCC"];
  node_5 [label="Node 5\nNBA: 3, TS: 2\nProgress: TRA\nMax Time: 253\nBatch: 0\nRobots: [0,1,0,1]", fillcolor="#FFFFCC"];
