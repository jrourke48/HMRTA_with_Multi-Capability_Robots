  node_2 -> node_3 [label="cost=172"];
  node_3 -> node_4 [label="cost=173"];
  node_4 -> node_5 [label="cost=253"];
  node_5 -> node_6 [label="cost=308"];
  node_6 -> node_7 [label="cost=356"];
